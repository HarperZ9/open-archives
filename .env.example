# Copy to .env and fill in only the keys you have. Every key is optional.
# Keyed adapters stay skipped while their variable is empty.
SI_API_KEY=
NYPL_API_TOKEN=
EUROPEANA_API_KEY=
FREESOUND_API_KEY=
BHL_API_KEY=

# Library location and guards (optional).
OPEN_ARCHIVES_LIBRARY=
OPEN_ARCHIVES_ROOTS=
OPEN_ARCHIVES_FORBIDDEN_DRIVES=
OPEN_ARCHIVES_FFMPEG=
